# ==========================================================================
# Viranikosh Backend — Environment Template
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# NEVER commit the real .env (it is gitignored). Rotate any key that leaks.
# ==========================================================================

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# In dev, localhost origins are allowed automatically.
# Production example: CORS_ORIGINS=https://viranikosh-x5e3.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL / Supabase) -------------------------------------
# DATABASE_URL  -> pooled connection (used by the app at runtime).
# DIRECT_URL    -> direct connection (used by Prisma for migrations).
# For Supabase, DATABASE_URL uses the pgBouncer port (6543) with
# ?pgbouncer=true, and DIRECT_URL uses the direct port (5432).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth (JWT) -----------------------------------------------------------
# Use a long, random secret in production (e.g. `openssl rand -base64 48`).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

# --- AI Providers ---------------------------------------------------------
# Transcription (Groq Whisper) + text fallback for translation/tagging.
GROQ_API_KEY=
# Translation + tag/category/region extraction (primary).
GEMINI_API_KEY=
# Long-text summarization (optional — summarization is skipped if unset).
COHERE_API_KEY=

# --- Media Storage (Cloudinary) -------------------------------------------
# Uploads go to Cloudinary; falls back to local disk (UPLOAD_DIR) on failure.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local disk fallback directory for uploaded media.
UPLOAD_DIR=uploads
