# ==========================================================================
# Viranikosh — environment template
# --------------------------------------------------------------------------
# Two ways to use this file:
#   1. Docker Compose:  cp .env.example .env   (uses POSTGRES_* below)
#   2. Manual / Render: set DATABASE_URL + DIRECT_URL (Supabase), and the
#      keys below. Never commit the real .env.
# ==========================================================================

# --- Database (Supabase / PostgreSQL) — REQUIRED in production -------------
# Pooled connection (use for normal queries). For Supabase, this is the
# 6543 (pgbouncer) URL.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma for migrations). Supabase 5432 URL.
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Local Postgres (only needed for docker compose `db` service) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viranikosh

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origin the browser loads the frontend from (compose exposes it on :8080).
CORS_ORIGINS=http://localhost:8080

# --- AI Providers (required by backend startup validation) ----------------
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional — summarization is skipped if unset.
COHERE_API_KEY=

# --- Media Storage (Cloudinary; required by backend startup validation) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
