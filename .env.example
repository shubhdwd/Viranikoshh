# ==========================================================================
# Viranikosh — docker compose environment
# --------------------------------------------------------------------------
# Copy to `.env` (next to docker-compose.yml) and fill in real values:
#     cp .env.example .env
# Used only by `docker compose`. Never commit the real .env.
# ==========================================================================

# --- Local Postgres (compose `db` service) --------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viranikosh

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origin the browser loads the frontend from (compose exposes it on :8080).
CORS_ORIGINS=http://localhost:8080

# --- AI Providers (required by backend startup validation) ----------------
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional — summarization is skipped if unset.
COHERE_API_KEY=

# --- Media Storage (Cloudinary; required by backend startup validation) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
